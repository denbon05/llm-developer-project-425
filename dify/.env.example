# Copy to dify/.env for local use. Never commit dify/.env (gitignored).
# Values below are local-dev placeholders only — replace before any shared use.

# --- URLs (loopback admin UI; see docs/setup.md) ---
CONSOLE_API_URL=
SERVER_CONSOLE_API_URL=http://api:5001
CONSOLE_WEB_URL=
SERVICE_API_URL=
APP_API_URL=
APP_WEB_URL=
FILES_URL=
TRIGGER_URL=http://127.0.0.1:13080
ENDPOINT_URL_TEMPLATE=http://127.0.0.1:13080/e/{hook_id}
# Must match the host you type in the browser (localhost vs 127.0.0.1).
NEXT_PUBLIC_SOCKET_URL=ws://localhost:13080
EXPOSE_NGINX_PORT=13080

# --- Security ---
# Leave empty to let Dify auto-generate a persistent key under storage.
SECRET_KEY=
# Optional /install gate only (max 30 chars). NOT the admin login password.
# Leave empty for fastest local first-time setup. If set, the install page asks
# for this value before you can create the admin account.
INIT_PASSWORD=
# Local-dev admin account is created in the UI (or flask reset-password), not
# via env. Suggested first-time values (docs/setup.md): email
# admin@example.test / password local-dify-admin-change-me
DEPLOY_ENV=PRODUCTION
LOG_LEVEL=INFO
MIGRATION_ENABLED=true

# --- Database (Dify PostgreSQL only; not the ticket DB) ---
DB_TYPE=postgresql
DB_USERNAME=postgres
DB_PASSWORD=local-dify-db-change-me
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify
DB_PLUGIN_DATABASE=dify_plugin
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1024MB
POSTGRES_STATEMENT_TIMEOUT=0
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=0
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=5
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=local-dify-redis-change-me
REDIS_USE_SSL=false
REDIS_DB=0
# Dify 1.16.1 applies this to Socket.IO's blocking pub/sub listen(). Default 5s
# causes "Cannot receive from redis... retrying" and Studio stuck on
# "Syncing data". Upstream omits the timeout (issue #39423); use a long value.
REDIS_SOCKET_TIMEOUT=3600
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
CELERY_BROKER_URL=redis://:local-dify-redis-change-me@redis:6379/1
CELERY_BACKEND=redis
CELERY_WORKER_AMOUNT=1
CELERY_WORKER_CLASS=
BROKER_USE_SSL=false

# --- Storage / Weaviate ---
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage
VECTOR_STORE=weaviate
VECTOR_INDEX_NAME_PREFIX=Vector_index
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=local-weaviate-api-key-change-me
WEAVIATE_GRPC_ENDPOINT=grpc://weaviate:50051
WEAVIATE_TOKENIZATION=word

# --- Sandbox / SSRF ---
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=local-dify-sandbox-change-me
CODE_EXECUTION_SSL_VERIFY=True
SANDBOX_API_KEY=local-dify-sandbox-change-me
SANDBOX_WORKER_TIMEOUT=15
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
SSRF_PROXY_ALLOW_PRIVATE_IPS=
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=

# --- Plugin daemon ---
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY=local-plugin-daemon-key-change-me
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_DEBUGGING_PORT=5003
EXPOSE_PLUGIN_DEBUGGING_PORT=5003
PLUGIN_DIFY_INNER_API_KEY=local-plugin-inner-api-key-change-me
PLUGIN_DIFY_INNER_API_URL=http://api:5001
FORCE_VERIFYING_SIGNATURE=true
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=120
PLUGIN_MAX_EXECUTION_TIMEOUT=600
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=https://marketplace.dify.ai

# --- CORS / web ---
WEB_API_CORS_ALLOW_ORIGINS=*
CONSOLE_CORS_ALLOW_ORIGINS=*
TEXT_GENERATION_TIMEOUT_MS=60000
TOP_K_MAX_VALUE=10
INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=4000

# --- Ollama (internal embedding host; model pull is later-phase) ---
# Base URL for Dify Ollama provider (configure in UI): http://ollama:11434
# Model tag to pin when ingesting knowledge: granite-embedding:30m
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=granite-embedding:30m
