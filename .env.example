# Application stack local settings. Copy to .env (gitignored).

GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_PORT=3143
GREENMAIL_API_PORT=8081

HELPDESK_DB_USER=helpdesk
HELPDESK_DB_PASSWORD=helpdesk
HELPDESK_DB_NAME=helpdesk
HELPDESK_DB_PORT=15432

TICKETING_PORT=18080

# Host tools (Alembic / curl-to-compose DB). Container URL is built in compose.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@127.0.0.1:15432/helpdesk

# Host IMAP/SMTP (Compose overrides hosts to greenmail / nginx in-network).
IMAP_HOST=127.0.0.1
IMAP_PORT=3143
IMAP_USER=support@example.test
IMAP_PASSWORD=support-pass
SMTP_HOST=127.0.0.1
SMTP_PORT=3025
SMTP_USER=support@example.test
SMTP_PASSWORD=support-pass
EMAIL_POLL_INTERVAL_SECONDS=60

# Dify Workflow Service API (not console). Key: Studio left sidebar API Access → Create API Key.
DIFY_WORKFLOW_URL=http://localhost:13080/v1/workflows/run
DIFY_EMAIL_HELPDESK_API_KEY='Bearer app-xxx'

# Trusted citation URL prefix (future knowledge_base/ paths). Empty citations are OK.
CITATION_REPO_BASE=https://github.com/denbon05/helpdesk/blob/main/knowledge_base/
